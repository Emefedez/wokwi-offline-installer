{
  "name": "7V Buck Voltage Regulator (12-24V IN -> 7V Servo Rail)",
  "author": "Wokwi Offline Suite",
  "pins": [
    "VIN_POS",
    "VIN_NEG",
    "VOUT_POS",
    "VOUT_NEG",
    "EN"
  ],
  "controls": [
    {
      "id": "vinVolts",
      "label": "Input Supply (12V-24V)",
