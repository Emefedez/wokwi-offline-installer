      "min": 8,
      "max": 28,
      "step": 1
    },
    {
      "id": "voutMv",
      "label": "Regulated Output (mV, default 7000mV for YB-P20M)",
      "type": "range",
      "min": 6000,
      "max": 7400,
      "step": 100
    }
  ]
}
